{
  "name": "rove",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Task and workflow assistant for getting digital work done",
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "agent:fixtures": "node experiments/agent-execution/run-fixtures.mjs",
    "agent:schema": "node experiments/agent-execution/generate-schema-evidence.mjs",
    "agent:live": "node experiments/agent-execution/live-app-server.mjs",
    "test:recovery:contract": "node experiments/agent-execution/run-lifecycle-contract.mjs",
    "test:recovery:processes": "pnpm build && node experiments/agent-execution/run-process-recovery.mjs",
    "test:attachments": "node experiments/agent-execution/task-attachment-boundary.mjs",
    "test:attachments:source-product": "pnpm --filter @rove/companion build && node experiments/agent-execution/task-attachment-source-product.mjs",
    "test:attachments:source-product-live": "pnpm --filter @rove/companion build && node experiments/agent-execution/task-attachment-source-product.mjs --canonical-product-home",
    "test:browser:live-stability": "pnpm --filter @rove/companion build && node experiments/agent-execution/source-product-stabilization-campaign.mjs",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "docker:up": "docker compose up --build --wait",
    "docker:dev": "docker compose up --build --watch",
    "docker:watch": "docker compose watch --no-up",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f --tail=200",
    "docker:reset": "docker compose down --volumes --remove-orphans",
    "dev:runtime": "pnpm --filter @rove/runtime dev",
    "dev:control-plane": "pnpm --filter @rove/control-plane dev",
    "dev:mcp": "pnpm --filter @rove/mcp dev",
    "dev:companion": "pnpm --filter @rove/companion dev",
    "test:mcp": "pnpm --filter @rove/mcp test",
    "browser:demo": "pnpm --filter @rove/browser demo",
    "browser:compat": "pnpm --filter @rove/browser compat",
    "browser:doctor": "pnpm --filter @rove/browser run doctor",
    "browser:soak": "pnpm --filter @rove/browser soak",
    "browser:inspect": "pnpm --filter @rove/browser inspect-demo",
    "browser:actions": "pnpm --filter @rove/browser actions-demo",
    "browser:capability-atlas": "vitest run packages/browser/src/experiments/capability-atlas-governance.test.ts packages/browser/src/experiments/capability-atlas-baseline.test.ts packages/browser/src/experiments/drag-move-strategies.test.ts",
    "browser:capabilities:integration": "vitest run packages/browser/src/experiments/capability-atlas-governance.test.ts packages/browser/src/experiments/capability-atlas-baseline.test.ts packages/browser/src/experiments/drag-move-strategies.test.ts packages/browser/src/playwright-browser-actions.test.ts apps/runtime/src/interaction/verified-interaction.test.ts apps/mcp/src/tools/browser.tools.test.ts",
    "browser:semantic-transactions": "vitest run packages/protocol/test/semantic-transaction.test.ts apps/runtime/src/interaction/semantic-transaction-store.test.ts apps/runtime/src/interaction/verified-interaction.test.ts apps/mcp/src/tools/browser.tools.test.ts apps/mcp/src/server/tool-catalog.test.ts apps/companion/src/main/host/hub-command-executor.test.ts apps/runtime/src/runtime.integration.test.ts apps/runtime/src/runtime-http.integration.test.ts",
    "runtime:demo": "pnpm build && ROVE_HOME=../../.rove-demo pnpm --filter @rove/runtime runtime-demo",
    "control:demo": "pnpm build && ROVE_HOME=../../.rove-control-demo pnpm --filter @rove/runtime control-demo",
    "test:e2e": "pnpm build && vitest run apps/mcp/test/e2e/session-lifecycle.e2e.test.ts",
    "auth:profile": "node scripts/auth-profile.mjs",
    "dev:desktop": "pnpm --filter @rove/companion dev:desktop",
    "package:desktop:prepare": "pnpm --filter @rove/companion package:prepare",
    "package:desktop:dir": "pnpm --filter @rove/companion package:dir",
    "package:desktop": "pnpm --filter @rove/companion package",
    "test:desktop:package": "node scripts/verify-desktop-package.mjs",
    "test:desktop:codex-components": "node scripts/verify-codex-component-set-fixtures.mjs",
    "browser:perception-benchmark": "pnpm --filter @rove/browser perception:benchmark",
    "browser:perception-baseline:inspect": "pnpm --filter @rove/browser perception:baseline:inspect",
    "browser:perception:research:evidence": "pnpm --filter @rove/browser perception:research:evidence",
    "browser:perception:research:strategies": "pnpm --filter @rove/browser perception:research:strategies",
    "browser:perception:validation:heldout": "pnpm --filter @rove/browser perception:validation:heldout",
    "browser:perception:validation:structural-semantics": "pnpm --filter @rove/browser perception:validation:structural-semantics",
    "browser:perception:validation:presentation-boundaries": "pnpm --filter @rove/browser perception:validation:presentation-boundaries",
    "browser:perception:validation:surface-grounding": "pnpm --filter @rove/browser perception:validation:surface-grounding",
    "browser:perception:validation:hidden-and-optional-surfaces": "pnpm --filter @rove/browser perception:validation:hidden-and-optional-surfaces",
    "browser:perception:validation:workflow-scope": "pnpm --filter @rove/browser perception:validation:workflow-scope",
    "browser:perception:validation:nested-scope-boundaries": "pnpm --filter @rove/browser perception:validation:nested-scope-boundaries",
    "browser:perception:validation:surface-ownership": "pnpm --filter @rove/browser perception:validation:surface-ownership",
    "browser:perception:validation:surface-placement-boundaries": "pnpm --filter @rove/browser perception:validation:surface-placement-boundaries",
    "browser:perception:validation:title-role": "pnpm --filter @rove/browser perception:validation:title-role",
    "browser:perception:validation:document-title-boundaries": "pnpm --filter @rove/browser perception:validation:document-title-boundaries",
    "browser:perception:validation:alert-precedence": "pnpm --filter @rove/browser perception:validation:alert-precedence",
    "browser:perception:validation:evidence-precedence-boundaries": "pnpm --filter @rove/browser perception:validation:evidence-precedence-boundaries",
    "browser:perception:validation:document-frame": "pnpm --filter @rove/browser perception:validation:document-frame",
    "browser:perception:validation:frame-ownership-boundaries": "pnpm --filter @rove/browser perception:validation:frame-ownership-boundaries",
    "check:repository": "node scripts/check-repository.mjs",
    "test:experiments": "node --test experiments/agent-execution/*.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "^22.17.0",
    "eslint": "^9.32.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.0",
    "vitest": "^3.2.4"
  }
}
