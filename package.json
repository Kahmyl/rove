{
  "name": "rove",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first browser task runtime for human-agent collaboration",
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "docker:up": "docker compose up --build --wait",
    "docker:dev": "docker compose up --build --watch",
    "docker:watch": "docker compose watch --no-up",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f --tail=200",
    "docker:reset": "docker compose down --volumes --remove-orphans",
    "dev:runtime": "pnpm --filter @rove/runtime dev",
    "dev:mcp": "pnpm --filter @rove/mcp dev",
    "dev:companion": "pnpm --filter @rove/companion dev",
    "test:mcp": "pnpm --filter @rove/mcp test",
    "browser:demo": "pnpm --filter @rove/browser demo",
    "browser:inspect": "pnpm --filter @rove/browser inspect-demo",
    "browser:actions": "pnpm --filter @rove/browser actions-demo",
    "runtime:demo": "pnpm build && ROVE_HOME=../../.rove-demo pnpm --filter @rove/runtime runtime-demo"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "^22.17.0",
    "eslint": "^9.32.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.0",
    "vitest": "^3.2.4"
  }
}
