{
  "name": "@rove/browser",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "compat": "tsx src/compatibility/browser-compat.ts",
    "soak": "tsx src/compatibility/browser-soak.ts",
    "demo": "tsx src/demo/browser-demo.ts",
    "doctor": "tsx src/diagnostics/browser-doctor.ts",
    "inspect-demo": "tsx src/demo/inspect-demo.ts",
    "actions-demo": "tsx src/demo/actions-demo.ts",
    "perception:benchmark": "tsx src/perception/benchmark/current-classifier-cli.ts",
    "perception:baseline:inspect": "tsx src/perception/benchmark/browser-inspect-baseline-cli.ts",
    "perception:research:evidence": "tsx src/perception/research/evidence-acquisition-cli.ts",
    "perception:research:strategies": "tsx src/perception/research/strategy-comparison-cli.ts",
    "perception:validation:heldout": "tsx src/perception/research/heldout-validation-cli.ts",
    "perception:validation:structural-semantics": "tsx src/perception/research/structural-semantic-validation-cli.ts",
    "perception:validation:presentation-boundaries": "tsx src/perception/research/presentation-boundaries-cli.ts",
    "perception:validation:surface-grounding": "tsx src/perception/research/surface-grounding-validation-cli.ts",
    "perception:validation:hidden-and-optional-surfaces": "tsx src/perception/research/hidden-and-optional-surfaces-cli.ts",
    "perception:validation:workflow-scope": "tsx src/perception/research/workflow-scope-validation-cli.ts",
    "perception:validation:nested-scope-boundaries": "tsx src/perception/research/nested-scope-boundaries-cli.ts",
    "perception:validation:surface-ownership": "tsx src/perception/research/surface-ownership-validation-cli.ts",
    "perception:validation:surface-placement-boundaries": "tsx src/perception/research/surface-placement-boundaries-cli.ts",
    "perception:validation:title-role": "tsx src/perception/research/title-role-validation-cli.ts",
    "perception:validation:document-title-boundaries": "tsx src/perception/research/document-title-boundaries-cli.ts",
    "perception:validation:alert-precedence": "tsx src/perception/research/alert-precedence-validation-cli.ts",
    "perception:validation:evidence-precedence-boundaries": "tsx src/perception/research/evidence-precedence-boundaries-cli.ts",
    "perception:validation:document-frame": "tsx src/perception/research/document-frame-validation-cli.ts",
    "perception:validation:frame-ownership-boundaries": "tsx src/perception/research/frame-ownership-boundaries-cli.ts"
