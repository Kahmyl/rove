# syntax=docker/dockerfile:1.7
FROM node:22-bookworm-slim

ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

RUN corepack enable
WORKDIR /workspace

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY apps/control-plane/package.json apps/control-plane/package.json
COPY apps/mcp/package.json apps/mcp/package.json
COPY packages/protocol/package.json packages/protocol/package.json
COPY packages/config/package.json packages/config/package.json

RUN --mount=type=cache,id=rove-pnpm,target=/pnpm/store \
    pnpm install --frozen-lockfile

COPY . .

# Build only deployable server-side applications and their shared packages.
# Runtime, Companion, Playwright, and browser binaries remain on the host Hub.
RUN pnpm --filter @rove/control-plane... --filter @rove/mcp... build

CMD ["pnpm", "--filter", "@rove/control-plane", "start"]
