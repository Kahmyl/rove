ROVE_HOME=.rove
ROVE_RUNTIME_HOST=127.0.0.1
ROVE_RUNTIME_PORT=47820
ROVE_RUNTIME_URL=http://127.0.0.1:47820
ROVE_RUNTIME_TOKEN=
ROVE_BROWSER=chrome
ROVE_BROWSER_HEADLESS=false
ROVE_BROWSER_MIN_ACTION_INTERVAL_MS=3000
ROVE_BROWSER_TYPING_DELAY_MS=35
ROVE_MCP_TRANSPORT=stdio
ROVE_MCP_HOST=127.0.0.1
ROVE_MCP_PORT=47821
ROVE_MCP_PATH=/mcp
ROVE_MCP_ALLOWED_HOSTS=127.0.0.1:47821,localhost:47821
# Required only for Streamable HTTP. Never commit a real token.
ROVE_MCP_TOKEN=

# Production-shaped local relay development. Replace every token outside local development.
ROVE_CONTROL_PLANE_HOST=127.0.0.1
ROVE_CONTROL_PLANE_PORT=47830
ROVE_CONTROL_PLANE_URL=http://127.0.0.1:47830
ROVE_HUB_DEVICE_ID=local-dev
ROVE_HUB_TOKEN=rove-local-hub-token-change-me
ROVE_CONTROL_PLANE_SERVICE_TOKEN=rove-local-service-token-change-me
