{
  "name": "@rove/companion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main/main/main.js",
  "scripts": {
    "build": "tsc -b tsconfig.json --force && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "pnpm --filter @rove/config build && pnpm build && electron .",
    "dev:desktop": "pnpm -w build && electron . --rove-manage-runtime"
  },
  "dependencies": {
    "@rove/protocol": "workspace:*",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "@rove/config": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^37.2.6",
    "vite": "^7.1.2"
  }
}
