{
  "name": "@rove/runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "node --watch --env-file-if-exists=../../.env --import tsx src/main.ts",
    "start": "node dist/main.js",
    "runtime-demo": "tsx src/demo/runtime-demo.ts",
    "control-demo": "tsx src/demo/control-demo.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@rove/browser": "workspace:*",
    "@rove/config": "workspace:*",
    "@rove/protocol": "workspace:*",
    "@rove/storage": "workspace:*",
    "file-type": "^21.3.4",
    "mime-types": "^3.0.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/mime-types": "^3.0.1",
    "tsx": "^4.20.3"
  }
}
